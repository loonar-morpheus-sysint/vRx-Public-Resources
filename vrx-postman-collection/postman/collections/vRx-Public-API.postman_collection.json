    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Status HTTP esperado', function () {",
          "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 202, 204]);",
          "});",
          "",
          "pm.test('Tempo de resposta aceitável (< 15s)', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(15000);",
          "});",
          "",
          "const bodyText = pm.response.text();",
          "if (pm.response.code !== 204 && bodyText && bodyText.trim().length > 0) {",
          "  let jsonData = null;",
          "  pm.test('Resposta é JSON válido', function () {",
          "    jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.exist;",
          "  });",
          "",
          "  if (jsonData && typeof jsonData === 'object') {",
          "    pm.test('Envelope conhecido ou objeto válido', function () {",
          "      const hasKnownEnvelope = Object.prototype.hasOwnProperty.call(jsonData, 'serverResponseObject') ||",
          "        Object.prototype.hasOwnProperty.call(jsonData, 'serverResponseCount');",
          "      pm.expect(hasKnownEnvelope || Object.keys(jsonData).length >= 0).to.eql(true);",
          "    });",
          "",
          "    if (Object.prototype.hasOwnProperty.call(jsonData, 'serverResponseCount')) {",
          "      pm.test('serverResponseCount é numérico', function () {",
          "        pm.expect(jsonData.serverResponseCount).to.be.a('number');",
          "      });",
          "    }",
          "",
          "    if (Object.prototype.hasOwnProperty.call(jsonData, 'serverResponseObject')) {",
          "      pm.test('serverResponseObject existe', function () {",
          "        pm.expect(jsonData.serverResponseObject).to.not.equal(undefined);",
          "      });",
          "    }",
          "  }",
          "}"
        ]
      }
